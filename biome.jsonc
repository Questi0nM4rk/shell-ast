{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "overrides": [
    {
      // wasm_exec.js is a vendored Go standard library file — not ours to lint
      "includes": ["src/wasm_exec.js"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      // Smoke entry-point scripts use console.log/error as their result channel —
      // they're CLI binaries, not library code.
      "includes": ["tests/smoke/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      // Tests own their fixture inputs — `ast.stmts[0]!` is the standard
      // shape for "the test asserts what it constructs", and a null deref
      // is a test failure already. Tests also legitimately contain literal
      // shell `${...}` strings in fixtures (we're a shell parser).
      "includes": ["tests/**/*.ts"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noTemplateCurlyInString": "off" }
        }
      }
    }
  ]
}
